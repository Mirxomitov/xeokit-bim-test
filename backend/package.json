{
  "name": "@bim/backend",
  "version": "0.1.0",
  "private": true,
  "description": "xeokit BIM backend: models and element statuses (NestJS + PostgreSQL, CIP stack)",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && nest build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
