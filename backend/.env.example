# Copy to .env for local development. Validated in src/config/env.ts.
# 0.0.0.0 so a phone on the same Wi-Fi reaches the API; 127.0.0.1 keeps it on this Mac.
HOST=0.0.0.0
PORT=8091
# compose.yaml's local PostgreSQL
DATABASE_URL=postgres://bim:local-bim-development-only@127.0.0.1:55434/bim
# Folder with the .xkt models; each new file is registered (and gets test statuses) on startup.
MODELS_DIR=models
